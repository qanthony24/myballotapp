2","title":"Lakeview Crime Prvntn Dis -- $100 Annual Fee Renewal -- Parish Council 4yr","officeName":"Proposition","contestType":"measure","totalVotes":6989,"called":true,"winnerId":"3","resultItems":[{"id":"3","name":"YES","votes":5467,"votePercent":78.2,"isWinner":true,"outcome":"Approved"},{"id":"4","name":"NO","votes":1522,"votePercent":21.8}],"parish":"Orleans","level":999,"generalTitle":"Proposition","numberToBeElected":1,"summary":"LAKEVIEW CRIME PREVENTION DISTRICT PROPOSITION\n\nSUMMARY: RENEWAL OF A FOUR YEAR SPECIAL ANNUAL FEE OF ONE HUNDRED DOLLARS ($100.00) FOR THE PREVENTION OF CRIME AND TO INCREASE THE PRESENCE OF LAW ENFORCEMENT PERSONNEL IN THE LAKEVIEW CRIME PREVENTION DISTRICT.","precinctsReporting":23,"precinctsExpected":23},{"contestId":"2743","title":"N. O. Business & Indus Dt -- P/W -- 22.79 Mills -- Council","officeName":"Proposition","contestType":"measure","totalVotes":109232,"called":true,"winnerId":"3","resultItems":[{"id":"3","name":"YES","votes":69980,"votePercent":64.1,"isWinner":true,"outcome":"Approved"},{"id":"4","name":"NO","votes":39252,"votePercent":35.9}],"parish":"Orleans","level":999,"generalTitle":"Proposition","numberToBeElected":1,"summary":"NEW ORLEANS BUSINESS AND INDUSTRIAL DISTRICT PROPOSITION\n\nSUMMARY: CONTINUED AUTHORITY TO LEVY NOT EXCEEDING 22.79 MILLS ON THE DOLLAR ONLY UPON ALL TAXABLE REAL PROPERTY SITUATED WITHIN THE BOUNDARIES OF THE NEW ORLEANS BUSINESS AND INDUSTRIAL DISTRICT (THE \"DISTRICT\") FOR AN ADDITIONAL 10 YEARS, BEGINNING WITH THE YEAR 2002 AND ENDING WITH THE YEAR 2011, SOLELY AND EXCLUSIVELY FOR THE PURPOSES AND BENEFIT OF THE DISTRICT. PROPERTY OCCUPIED IN WHOLE OR IN PART AS A RESIDENCE BY AN OWNER THEREOF SHALL NOT BE SUBJECT TO THE TAX LEVY. THE DISTRICT IS GENERALLY BOUNDED BY THE FOLLOWING STREETS AND WATERWAYS: THE INDUSTRIAL CANAL TO THE WEST; CHEF MENTEUR HIGHWAY TO THE NORTH; THE MAXENT CANAL TO THE EAST; AND THE INTRACOASTAL WATERWAY TO THE SOUTH.","precinctsReporting":442,"precinctsE